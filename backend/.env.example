# Server Port Configuration
PORT=5000

# Database Connection String (MongoDB Local or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/unify_db

# Secret Key for JSON Web Token Signing & Verification
JWT_SECRET=your_super_secret_jwt_key_here

# Server Environment Mode (development / production)
NODE_ENV=development

# Allowed CORS Client URL
CLIENT_URL=http://localhost:5173
